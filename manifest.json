{
  "manifestVersion": 5,
  "id": "com.fuqingyinxiang.idphoto.panel",
  "name": "证件照排版 MAX",
  "version": "0.5.9",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "extensions": [
        ".idprint"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "idphoto-max-panel",
      "label": {
        "default": "证件照排版 MAX"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      }
    }
  ]
}
